rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo esta cuenta puede entrar, y solo a su propio documento.
    // Si otra persona inicia sesión con Google, no lee ni escribe nada.
    function esElDueno() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'gzalba@gmail.com';
    }

    match /usuarios/{uid} {
      allow read, write: if esElDueno() && request.auth.uid == uid;

      // Comprobantes: un documento por archivo, para no engordar el principal
      match /comprobantes/{archivo} {
        allow read, write: if esElDueno() && request.auth.uid == uid;
      }
    }
  }
}
