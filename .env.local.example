# Copiá este archivo como .env.local y completá con los valores de tu proyecto Firebase.
# Firebase → Configuración del proyecto (⚙️) → Tus apps → App web → Configuración del SDK.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MSG_SENDER_ID=
VITE_FB_APP_ID=

# Opcional: única cuenta de Google habilitada. Si no se carga, es gzalba@gmail.com.
# Ojo: esto solo cambia la app. Quien protege los datos es firestore.rules, que se edita y publica aparte.
VITE_EMAIL_AUTORIZADO=
